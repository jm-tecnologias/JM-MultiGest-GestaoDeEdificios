                              <TextArea fx:id="descricaoField" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="49.0" minWidth="0.0" prefHeight="115.0" prefWidth="182.0" promptText="Descrição" styleClass="notes-area" wrapText="true">
