                                 </font>
                              </Label>
                              <TableView fx:id="membroTabela" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" styleClass="management-table" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn fx:id="estadoColumnMembro" prefWidth="85.0" text="Estado" />
                                    <TableColumn fx:id="notasColumnMembro" prefWidth="203.0" text="Notas" />
                                 </columns>
                              </TableView>
                           </children>
                        </VBox>

                        <VBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" spacing="5.0" GridPane.columnIndex="2">
                           <children>
                              <Label styleClass="history-title" text="Historico de visitante">
                                 <font><Font name="System Bold" size="22.0" /></font>
                              </Label>
                              <TableView fx:id="visitanteTabela" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" styleClass="management-table" VBox.vgrow="ALWAYS">
                                 <columns>
