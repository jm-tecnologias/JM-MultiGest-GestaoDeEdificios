<AnchorPane id="AnchorPane" minHeight="0.0" minWidth="0.0" prefHeight="594.0" prefWidth="837.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jmmultigest.controllers.PortariaController">
