                                          <Label fx:id="estadoLabelMembro" maxWidth="1.7976931348623157E308" minWidth="0.0" HBox.hgrow="ALWAYS"><font><Font size="14.0" /></font></Label>
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>

                              <VBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" spacing="5.0" styleClass="identity-block" GridPane.columnIndex="1">
                                 <children>
                                    <Label styleClass="section-title-small" text="Visitante">
