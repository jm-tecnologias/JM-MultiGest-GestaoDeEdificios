                                       <children>
                                          <Label minWidth="80.0" prefWidth="80.0" text="Estado:"><font><Font name="System Bold" size="14.0" /></font></Label>
                                          <Label fx:id="estadoLabelVisitante" maxWidth="1.7976931348623157E308" minWidth="0.0" HBox.hgrow="ALWAYS"><font><Font size="14.0" /></font></Label>
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>

                              <TextArea fx:id="notasField" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="49.0" minWidth="0.0" prefHeight="49.0" prefWidth="533.0" promptText="Notas..." styleClass="notes-area" wrapText="true" GridPane.columnSpan="2" GridPane.rowIndex="1">
