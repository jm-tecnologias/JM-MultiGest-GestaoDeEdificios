<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="1000.0" stylesheets="@../styles/main.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jmmultigest.controllers.MainController">
   <top>
      <AnchorPane maxHeight="50.0" minHeight="50.0" prefHeight="50.0" styleClass="app-header" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" minWidth="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="0.0">
               <children>
                  <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../../../../../../Downloads/ChatGPT%20Image%20Sep%2010,%202026,%2011_45_35%20AM.png" />
                     </image>
                  </ImageView>

                  <VBox alignment="CENTER_RIGHT" minWidth="0.0" prefHeight="50.0" prefWidth="131.0">
                     <children>
                        <Label styleClass="brand-title" text="JM MultiGest" />
                        <Label styleClass="header-secondary" text="Gestão de Edificios" />
                     </children>
                  </VBox>

                  <Region minWidth="0.0" prefHeight="50.0" prefWidth="342.0" HBox.hgrow="ALWAYS" />

                  <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../../../../../../Downloads/ChatGPT%20Image%20Sep%2010,%202026,%2011_45_35%20AM.png" />
                     </image>
                  </ImageView>

                  <VBox alignment="CENTER_RIGHT" minWidth="0.0" prefHeight="50.0" prefWidth="131.0">
                     <children>
                        <Label styleClass="user-name" text="Amilcar Mula" />
                        <Label styleClass="header-secondary" text="Supervisor" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </AnchorPane>
   </top>

   <left>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" maxWidth="200.0" minWidth="160.0" pannable="false" prefWidth="200.0" styleClass="sidebar-scroll" vbarPolicy="AS_NEEDED" BorderPane.alignment="CENTER">
         <content>
            <VBox fillWidth="true" spacing="10.0" styleClass="sidebar-menu">
               <children>
                  <Button fx:id="btn_dashboard" alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#switchForm" styleClass="sidebar-button" text="Dashboard">
                     <VBox.margin><Insets left="5.0" right="5.0" top="5.0" /></VBox.margin>
                     <graphic><ImageView fitHeight="25.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true" /></graphic>
                  </Button>
                  <Button alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="sidebar-button" text="Edificio">
                     <VBox.margin><Insets left="5.0" right="5.0" top="5.0" /></VBox.margin>
                     <graphic><ImageView fitHeight="25.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true" /></graphic>
                  </Button>
                  <Button fx:id="btn_apartamento" alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#switchForm" styleClass="sidebar-button" text="Apartamentos">
                     <VBox.margin><Insets left="5.0" right="5.0" top="5.0" /></VBox.margin>
                     <graphic><ImageView fitHeight="25.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true" /></graphic>
                  </Button>
                  <Button fx:id="btn_cliente" alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#switchForm" styleClass="sidebar-button" text="Clientes">
                     <VBox.margin><Insets left="5.0" right="5.0" top="5.0" /></VBox.margin>
                     <graphic><ImageView fitHeight="25.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true" /></graphic>
                  </Button>
                  <Button alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="sidebar-button" text="Membros">
                     <VBox.margin><Insets left="5.0" right="5.0" top="5.0" /></VBox.margin>
                     <graphic><ImageView fitHeight="25.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true" /></graphic>
                  </Button>
                  <Button fx:id="btn_visitante" alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#switchForm" styleClass="sidebar-button" text="Visitantes">
                     <VBox.margin><Insets left="5.0" right="5.0" top="5.0" /></VBox.margin>
                     <graphic><ImageView fitHeight="25.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true" /></graphic>
                  </Button>
                  <Button alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="sidebar-button" text="Departamentos">
                     <VBox.margin><Insets left="5.0" right="5.0" top="5.0" /></VBox.margin>
                     <graphic><ImageView fitHeight="25.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true" /></graphic>
                  </Button>
                  <Button alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="sidebar-button" text="Funcionarios">
                     <VBox.margin><Insets left="5.0" right="5.0" top="5.0" /></VBox.margin>
                     <graphic><ImageView fitHeight="25.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true" /></graphic>
                  </Button>
                  <Button fx:id="btn_seguranca" alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#switchForm" styleClass="sidebar-button" text="Segurança">
                     <VBox.margin><Insets left="5.0" right="5.0" top="5.0" /></VBox.margin>
                     <graphic><ImageView fitHeight="25.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true" /></graphic>
                  </Button>
                  <Button alignment="TOP_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="sidebar-button" text="Definições">
                     <VBox.margin><Insets bottom="5.0" left="5.0" right="5.0" top="5.0" /></VBox.margin>
                     <graphic><ImageView fitHeight="25.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true" /></graphic>
                  </Button>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </left>

   <center>
      <AnchorPane fx:id="mainViewer" minHeight="0.0" minWidth="0.0" style="-fx-background-color: red;" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
